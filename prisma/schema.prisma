// Option Sets Pro — Prisma Schema
// Development: SQLite | Production: switch provider to "postgresql"
// DATABASE_URL examples:
//   SQLite:      file:./dev.sqlite
//   PostgreSQL:  postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage (required by @shopify/shopify-app-session-storage-prisma)
// ---------------------------------------------------------------------------

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OptionSetStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum AssignmentMode {
  ALL_PRODUCTS
  MANUAL
  CONDITIONS
}

enum FieldType {
  HEADING
  PARAGRAPH
  DIVIDER
  SPACER
  TEXT_BOX
  TEXTAREA
  DROPDOWN
  CHECKBOX
  RADIO_BUTTON
  SWITCH
  BUTTONS
  COLOR_SWATCHES
  IMAGE_SWATCHES
  FILE_UPLOAD
  DATE_PICKER
  TIME_PICKER
  DATE_RANGE
  NUMBER
  RANGE_SLIDER
  QUANTITY
  PRODUCT_PICKER
  CUSTOM_HTML
  HIDDEN_FIELD
  GROUP
}

enum ConditionalAction {
  SHOW
  HIDE
  ENABLE
  DISABLE
  REQUIRE
}

enum ConditionalLogic {
  AND
  OR
}

enum PriceRuleType {
  FIXED
  PERCENTAGE
  QUANTITY
  FORMULA
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ---------------------------------------------------------------------------
// Option Sets engine
// ---------------------------------------------------------------------------

model OptionSet {
  id          String          @id @default(cuid())
  shop        String
  name        String
  description String?
  status      OptionSetStatus @default(ACTIVE)
  assignmentMode AssignmentMode @default(MANUAL)
  /// Product matching conditions stored as JSON.
  assignmentConditions String?
  priority    Int             @default(0)
  /// Internal notes for merchants (not shown on storefront)
  internalNote String?
  /// Soft delete timestamp; null = not deleted
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  fields                 OptionField[]
  conditionalRules       ConditionalRule[]
  priceRules             PriceRule[]
  productAssignments     ProductAssignment[]
  collectionAssignments  CollectionAssignment[]
  vendorAssignments      VendorAssignment[]
  tagAssignments         TagAssignment[]
  productTypeAssignments ProductTypeAssignment[]

  @@index([shop, status])
  @@index([shop, name])
  @@index([shop, updatedAt])
  @@index([shop, deletedAt])
}

model OptionField {
  id                 String    @id @default(cuid())
  optionSetId        String
  /// Parent field for nested groups
  parentId           String?
  type               FieldType
  label              String
  description        String?
  placeholder        String?
  required           Boolean   @default(false)
  hidden             Boolean   @default(false)
  defaultValue       String?
  /// JSON validation rules (pattern, min, max, etc.)
  validation         String?
  cssClass           String?
  tooltip            String?
  helpText           String?
  customErrorMessage String?
  minQuantity        Int?
  maxQuantity        Int?
  minLength          Int?
  maxLength          Int?
  sortOrder          Int       @default(0)
  collapsed          Boolean   @default(false)
  /// Type-specific settings stored as JSON string
  settings           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  optionSet          OptionSet         @relation(fields: [optionSetId], references: [id], onDelete: Cascade)
  parent             OptionField?      @relation("FieldNesting", fields: [parentId], references: [id], onDelete: Cascade)
  children           OptionField[]     @relation("FieldNesting")
  choices            FieldChoice[]
  priceRules         PriceRule[]
  targetRules        ConditionalRule[] @relation("RuleTargetField")
  triggerRules       ConditionalRule[] @relation("RuleTriggerField")

  @@index([optionSetId, sortOrder])
  @@index([parentId])
}

model FieldChoice {
  id           String   @id @default(cuid())
  fieldId      String
  label        String
  value        String
  imageUrl     String?
  colorHex     String?
  /// Fixed price add-on for this choice (optional shortcut)
  priceAddon   Float?
  isDefault    Boolean  @default(false)
  isDisabled   Boolean  @default(false)
  sortOrder    Int      @default(0)
  /// Extra choice metadata as JSON
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  field      OptionField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  priceRules PriceRule[]

  @@index([fieldId, sortOrder])
}

model ConditionalRule {
  id             String            @id @default(cuid())
  optionSetId    String
  targetFieldId  String
  /// Optional primary trigger field for indexed lookups
  triggerFieldId String?
  action         ConditionalAction
  logic          ConditionalLogic  @default(AND)
  /// Nested condition tree as JSON:
  /// [{ fieldId, operator, value }, ...]
  conditions     String
  sortOrder      Int               @default(0)
  enabled        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  optionSet    OptionSet   @relation(fields: [optionSetId], references: [id], onDelete: Cascade)
  targetField  OptionField @relation("RuleTargetField", fields: [targetFieldId], references: [id], onDelete: Cascade)
  triggerField OptionField? @relation("RuleTriggerField", fields: [triggerFieldId], references: [id], onDelete: SetNull)

  @@index([optionSetId])
  @@index([targetFieldId])
  @@index([triggerFieldId])
}

model PriceRule {
  id          String        @id @default(cuid())
  optionSetId String?
  fieldId     String?
  choiceId    String?
  type        PriceRuleType
  /// Fixed amount or percentage value
  amount      Float?
  /// Formula expression, e.g. "base + (qty * 2.5)"
  formula     String?
  /// Quantity tiers as JSON: [{ min, max, amount, type }]
  quantityTiers String?
  label       String?
  enabled     Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  optionSet OptionSet?   @relation(fields: [optionSetId], references: [id], onDelete: Cascade)
  field     OptionField? @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  choice    FieldChoice? @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@index([optionSetId])
  @@index([fieldId])
  @@index([choiceId])
}

// ---------------------------------------------------------------------------
// Assignments — multiple option sets may target the same product
// ---------------------------------------------------------------------------

model ProductAssignment {
  id          String   @id @default(cuid())
  optionSetId String
  shop        String
  productId   String
  productGid  String
  productTitle String?
  productHandle String?
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  optionSet OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Cascade)

  @@unique([optionSetId, productGid])
  @@index([shop, productGid])
  @@index([optionSetId])
}

model CollectionAssignment {
  id               String   @id @default(cuid())
  optionSetId      String
  shop             String
  collectionId     String
  collectionGid    String
  collectionTitle  String?
  collectionHandle String?
  priority         Int      @default(0)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  optionSet OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Cascade)

  @@unique([optionSetId, collectionGid])
  @@index([shop, collectionGid])
  @@index([optionSetId])
}

model VendorAssignment {
  id          String   @id @default(cuid())
  optionSetId String
  shop        String
  vendor      String
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  optionSet OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Cascade)

  @@unique([optionSetId, vendor])
  @@index([shop, vendor])
  @@index([optionSetId])
}

model TagAssignment {
  id          String   @id @default(cuid())
  optionSetId String
  shop        String
  tag         String
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  optionSet OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Cascade)

  @@unique([optionSetId, tag])
  @@index([shop, tag])
  @@index([optionSetId])
}

model ProductTypeAssignment {
  id          String   @id @default(cuid())
  optionSetId String
  shop        String
  productType String
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  optionSet OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Cascade)

  @@unique([optionSetId, productType])
  @@index([shop, productType])
  @@index([optionSetId])
}

// ---------------------------------------------------------------------------
// File uploads (customer storefront uploads)
// ---------------------------------------------------------------------------

model FileUpload {
  id           String   @id @default(cuid())
  shop         String
  optionSetId  String?
  fieldId      String?
  /// Shopify order / draft order reference when available
  orderId      String?
  orderGid     String?
  lineItemKey  String?
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  extension    String
  /// Storage key / path (S3, R2, local, etc.)
  storageKey   String
  storageUrl   String?
  checksum     String?
  validated    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop, createdAt])
  @@index([shop, orderGid])
  @@index([fieldId])
}

// ---------------------------------------------------------------------------
// App settings (one row per shop)
// ---------------------------------------------------------------------------

model Settings {
  id            String   @id @default(cuid())
  shop          String   @unique
  /// General app preferences as JSON
  general       String   @default("{}")
  /// Theme / storefront display settings as JSON
  theme         String   @default("{}")
  currency      String?
  /// Locale → translation map as JSON
  translations  String   @default("{}")
  customCss     String?
  customJs      String?
  /// File upload constraints as JSON { maxSizeMb, allowedExtensions[] }
  fileUpload    String   @default("{\"maxSizeMb\":10,\"allowedExtensions\":[\"jpg\",\"jpeg\",\"png\",\"gif\",\"pdf\",\"webp\"]}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit / application logs
// ---------------------------------------------------------------------------

model Log {
  id        String   @id @default(cuid())
  shop      String
  level     LogLevel @default(INFO)
  action    String
  message   String
  /// Structured context as JSON
  metadata  String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, level])
  @@index([shop, action])
}
