# Local development database (SQLite)
DATABASE_URL="file:./dev.sqlite"

# Production (PostgreSQL) example — do not commit real credentials:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/option_sets_pro?schema=public"

# Shopify credentials are injected by `shopify app dev` / Partner Dashboard.
# Never hardcode SHOPIFY_API_KEY / SHOPIFY_API_SECRET here for production.
